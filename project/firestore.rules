rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['prakranj@gmail.com', 'prakranj@1carehealth.co', 'gloryjain9@gmail.com'];
    }

    // One doc per Google account, keyed by lowercased email.
    // Users may create their own doc (approved == false) and update only the
    // login-tracking fields; they can never change `approved`. Admins can do
    // everything.
    match /userAccess/{email} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email.lower() == email);
      allow create: if isAdmin()
        || (request.auth != null
            && request.auth.token.email.lower() == email
            && request.resource.data.approved == false);
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.token.email.lower() == email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'displayName', 'lastSeenAt', 'loginCount']));
      allow delete: if isAdmin();
    }

    // Append-only login audit log. Users append their own events; only admins read.
    match /loginEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if false;
    }

    match /studentRecords/{studentId}/{recordType}/{recordId} {
      allow read: if request.auth != null
        && recordType in ['attendance', 'marksheets'];
      allow create, update: if request.auth != null
        && recordType == 'attendance'
        && request.resource.data.keys().hasOnly(['date', 'status', 'markedBy', 'markedByEmail', 'markedAt'])
        && request.resource.data.date == recordId
        && request.resource.data.status in ['present', 'absent', 'late'];
      allow create: if request.auth != null
        && recordType == 'marksheets'
        && request.resource.data.keys().hasOnly(['date', 'subject', 'score', 'maxScore', 'answers', 'attachmentUrl', 'attachmentName', 'markedBy', 'markedByEmail', 'markedAt'])
        && request.resource.data.date is string
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.maxScore > 0
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.answers is string
        && request.resource.data.answers.size() <= 50000
        && request.resource.data.attachmentUrl is string
        && request.resource.data.attachmentName is string;
      allow update, delete: if false;
    }
  }
}
